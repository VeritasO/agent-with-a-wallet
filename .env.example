# Copy to .env / export in your shell. NEVER commit real values.
# Default (mock) mode needs none of this.

# mock   = simulated PayPal sandbox, no network calls (default)
# sandbox = real PayPal sandbox via the developer app below
PAYPAL_MODE=mock

# From the entrant's PayPal developer dashboard (sandbox app):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The app's public base URL. PayPal redirects the payer back to
# <PUBLIC_BASE_URL>/gift/return after approval (and /gift/cancel on
# abandonment). Set this on hosted deployments; when unset, the server
# derives the base from each incoming request instead.
# PUBLIC_BASE_URL=https://agent-with-a-wallet.onrender.com

# Optional demo settings
PORT=4173
APPROVAL_THRESHOLD_CENTS=2500
